# pew2 daemon settings (optional). Copy the lines you need into your shell or
# service file. Nothing reads this file automatically: the daemon only sees
# process environment variables.

# Where pew2 keeps its state (pairing, logs, provider cache). Default: ~/.pew2
# PEW2_HOME=/path/to/state

# LAN WebSocket port for `pew2 serve`. Default: 8787
# PEW2_PORT=8787

# Default workspace for new sessions when the app does not name one.
# Default: the daemon's working directory, then your home directory.
# PEW2_WORKSPACE=/path/to/project

# Cloudflare relay URL for remote access, e.g. wss://your-worker.workers.dev
# PEW2_RELAY=

# Fixed pairing token for tests or containers. Must be at least 32 characters.
# Leave unset for normal use: pew2 pair creates and stores a token for you.
# PEW2_TOKEN=

# Set to 1 when running the daemon from source (not the compiled binary).
# PEW2_EXPERIMENTAL=1

# Opt-in metadata diagnostics (no message text, credentials, URLs, or argv).
# Writes ~/.pew2/logs/trace.log and trace.log.1, each capped at 8 MiB.
# Set in the daemon's service environment, then restart while idle.
# PEW2_LOG_LEVEL=silly
